@Library('jenkins-shared-library') _

pipeline {

    agent {
        label 'agent-1'
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '123456789.dkr.ecr.us-east-1.amazonaws.com'
        IMAGE_NAME   = 'frontend'
    }

    stages {

        stage('Code Checkout') {
            steps {
                cloneRepo(
                    'https://github.com/tusharyadav235/Microservice-project.git',
                    'main'
                )
            }
        }

        stage('Verify Tools') {
            steps {
                verifyTools2()
            }
        }

        stage('Build') {
            steps {
                npmBuild('frontend')
            }
        }

        stage('Unit Test') {
            steps {
                npmTest('frontend')
            }
        }

        stage('Dependency Check') {
            steps {
                npmDependencyCheck('frontend')
            }
        }

        stage('SonarQube Analysis') {
            steps {
                sonarAnalysis('frontend')
            }
        }

        stage('Quality Gate') {
            steps {
                qualityGate()
            }
        }

        stage('Docker Build') {
            steps {
                dockerBuild(
                    'frontend',
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}"
                )
            }
        }

        stage('Image Scan') {
            steps {
                trivyScan(
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}"
                )
            }
        }

        stage('AWS Authentication') {
            steps {
                awsAuthentication()
            }
        }

        stage('Authenticate Docker to ECR') {
            steps {
                ecrLogin(
                    "${AWS_REGION}",
                    "${ECR_REGISTRY}"
                )
            }
        }

        stage('Tag Image') {
            steps {
                tagEcrImage(
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}",
                    "${ECR_REGISTRY}"
                )
            }
        }

        stage('Push Image to ECR') {
            steps {
                pushEcrImage(
                    "${ECR_REGISTRY}",
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}"
                )
            }
        }

        stage('Promote to Dev') {
            steps {
                promoteToDevFrontend(
                    'frontend',
                    'tusharyadav235/gitops',
                    'main',
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}",
                    "${ECR_REGISTRY}"
                )
            }
        }

        stage('Production Approval') {
            steps {
                // Assuming you have this function or use the standard one
                productionApproval('frontend')
            }
        }

        stage('Promote to Production') {
            steps {
                promoteToProductionFrontend(
                    'frontend',
                    'tusharyadav235/gitops',
                    "${IMAGE_NAME}",
                    "${IMAGE_TAG}",
                    "${ECR_REGISTRY}"
                )
            }
        }
    }

    post {
        success {
            echo """
            CI/CD pipeline completed successfully.

            Application : ${IMAGE_NAME}
            Image Tag   : ${IMAGE_TAG}
            """
        }
        failure {
            echo """
            Pipeline failed.
            Check the failed stage and Jenkins console logs.
            """
        }
        always {
            echo "Cleaning Jenkins workspace"
            cleanWs()
        }
    }
}
