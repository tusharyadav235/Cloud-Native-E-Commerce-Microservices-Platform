pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = '123456789.dkr.ecr.us-east-1.amazonaws.com'
        IMAGE_NAME = 'cart-service'
        IMAGE_TAG = "${env.GIT_COMMIT}"
        // Requires credentials with these IDs in Jenkins
        AWS_CRED_ID = 'aws-credentials' 
        SONAR_TOKEN = credentials('sonar-token')
        GITOPS_TOKEN = credentials('gitops-token')
    }

    tools {
        // Must match the name configured in Jenkins "Global Tool Configuration"
        maven 'maven' 
        jdk 'jdk17' 
    }

    stages {
        stage('Build & Test') {
            steps {
                dir('cart-service') {
                    sh 'mvn clean package -DskipTests'
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit 'cart-service/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Security Analysis') {
            steps {
                dir('cart-service') {
                    withSonarQubeEnv('sonar-server-name') { // Match this to your Jenkins SonarQube configuration name
                        sh 'mvn sonar:sonar -Dsonar.token=$SONAR_TOKEN'
                    }
                    sh 'mvn org.owasp:dependency-check-maven:check'
                }
            }
        }

        stage('Docker Build, Scan, and Push') {
            steps {
                dir('cart-service') {
                    script {
                        // Using Docker Pipeline Plugin
                        docker.withRegistry("https://${ECR_REGISTRY}", "ecr:${AWS_REGION}:${AWS_CRED_ID}") {
                            def customImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "-f Dockerfile .")
                            
                            // Trivy Scan
                            sh "trivy image --severity HIGH,CRITICAL --exit-code 1 ${IMAGE_NAME}:${IMAGE_TAG}"
                            
                            customImage.push()
                        }
                    }
                }
            }
        }

        stage('Promote to Dev') {
            steps {
                sh '''
                    git config user.name "jenkins-agent"
                    git config user.email "jenkins-agent@jenkins.local"
                '''
                dir('k8s/overlays/dev') {
                    sh '''
                        kustomize edit set image cart-service=${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        kustomize build . > /tmp/dev-manifest.yaml
                    '''
                }
                sh '''
                    git add k8s/overlays/dev/kustomization.yaml
                    git commit -m "Promote cart-service ${IMAGE_TAG} to dev" || echo "No changes to commit"
                    git push origin HEAD:main
                '''
            }
        }

        stage('Promote to Production') {
            steps {
                dir('k8s/overlays/prod') {
                    sh '''
                        kustomize edit set image cart-service=${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        kustomize build . > /tmp/production-manifest.yaml
                    '''
                }
                sh '''
                    git add k8s/overlays/prod/kustomization.yaml
                    git commit -m "Promote cart-service ${IMAGE_TAG} to production" || echo "No changes to commit"
                    git push origin HEAD:main
                '''
            }
        }
    }
}
